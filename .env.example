# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# BSE Scraping Configuration
BSE_BASE_URL=https://www.bseindia.com
BSE_HOMEPAGE_PATH=/markets/MarketInfo/BhavCopy.aspx
BSE_DOWNLOAD_LINK_ID=ContentPlaceHolder1_btnhylZip
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Application Configuration
APP_NAME=BSE Stock Tracker
LOG_LEVEL=INFO
ENVIRONMENT=development

# Feature Flags
ENABLE_METRICS=true
ENABLE_BACKGROUND_JOBS=true

# Data Processing
TOP_N_STOCKS=10
SEARCH_RESULT_LIMIT=100
CACHE_TTL=300
